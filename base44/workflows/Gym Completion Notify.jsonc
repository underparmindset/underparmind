{
  "name": "Gym Completion Notify",
  "description": "Emails connected parents and coaches when a player completes a Mental Gym session",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "ModuleProgress",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.completed == true and (.trigger.old_data.completed // false) != true }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "gym_completion_notify",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyPlayerUpdate",
            "args": {
              "type": "gym",
              "record_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Email parents & coaches",
            "description": "Mental Gym session completed"
          }
        }
      }
    ]
  }
}