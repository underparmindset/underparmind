{
  "name": "Goal Update Notify",
  "description": "Emails connected parents and coaches when a player sets or updates a goal",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Goal",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": null
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "goal_update_notify",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyPlayerUpdate",
            "args": {
              "type": "goal",
              "record_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Email parents & coaches",
            "description": "Goal created or updated"
          }
        }
      }
    ]
  }
}