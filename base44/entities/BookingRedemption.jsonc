{
  "name": "BookingRedemption",
  "type": "object",
  "properties": {
    "checkout_session_id": {
      "type": "string",
      "description": "Stripe checkout session this record guards (one record per paid coaching checkout)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "claimed",
        "booked"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "green"
      ],
      "default": "pending",
      "description": "pending = paid, not yet booked; claimed = a booking request is in flight; booked = calendar event created"
    },
    "claim_token": {
      "type": "string",
      "description": "Token of the request that currently holds the claim"
    },
    "claimed_at": {
      "type": "string",
      "description": "When the claim was taken"
    },
    "booked_at": {
      "type": "string",
      "description": "When the session was successfully booked"
    },
    "calendar_event_id": {
      "type": "string",
      "description": "Google Calendar event created for this redemption"
    },
    "booking_email": {
      "type": "string",
      "description": "Email the session was booked for"
    }
  },
  "required": [
    "checkout_session_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}