{
  "name": "Round",
  "type": "object",
  "properties": {
    "course_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "round_type": {
      "type": "string",
      "enum": [
        "Practice",
        "Casual",
        "Qualifier",
        "Tournament"
      ]
    },
    "hole_pars": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "hole_scores": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "hole_fir": {
      "type": "array",
      "items": {
        "type": "boolean"
      }
    },
    "hole_gir": {
      "type": "array",
      "items": {
        "type": "boolean"
      }
    },
    "hole_putts": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "total_score": {
      "type": "number"
    },
    "total_par": {
      "type": "number"
    },
    "total_putts": {
      "type": "number"
    },
    "fir_count": {
      "type": "number"
    },
    "fir_total": {
      "type": "number"
    },
    "gir_count": {
      "type": "number"
    },
    "calm_rating": {
      "type": "number"
    },
    "routine_pct": {
      "type": "number"
    },
    "reset_rating": {
      "type": "number"
    },
    "focus6_rating": {
      "type": "number"
    },
    "regret_shot": {
      "type": "string"
    },
    "well_done": {
      "type": "string"
    },
    "holes_played": {
      "type": "number"
    },
    "best_shot": {
      "type": "string",
      "maxLength": 140,
      "description": "Quick Capture: best shot of the day"
    },
    "turning_point_hole": {
      "type": "number",
      "description": "Quick Capture: hole where the round turned"
    },
    "turning_point_dir": {
      "type": "string",
      "enum": [
        "better",
        "worse"
      ],
      "enumColors": [
        "green",
        "red"
      ],
      "description": "Quick Capture: did the round turn better or worse on that hole"
    },
    "turning_point_note": {
      "type": "string",
      "description": "Quick Capture: one line on what happened when the round turned"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Quick Capture: three facts from the round (Mental Gym Week 3 format)"
    },
    "lesson": {
      "type": "string",
      "description": "Quick Capture: one lesson from the round"
    },
    "no_insults": {
      "type": "boolean",
      "default": false,
      "description": "Quick Capture: player confirmed the notes contain no insults, only facts"
    },
    "round_notes": {
      "type": "string",
      "description": "Anything else the player wants to remember about the round"
    }
  },
  "required": [
    "course_name",
    "date",
    "round_type"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}